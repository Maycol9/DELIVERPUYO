# Copie este archivo a .env para desarrollo local. Use credenciales ficticias aquí.
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/deliverpuyo
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=example-only-replace-with-a-random-secret-of-32-chars-minimum
JWT_REFRESH_SECRET=example-only-use-a-different-random-secret-of-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PRODUCT_CACHE_TTL_SECONDS=120
QUEUE_ENABLED=true
ENABLE_BENCHMARK_ENDPOINTS=false
# En producción, configure aquí los orígenes reales de Flutter Web, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
